{
  "name": "pulse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @pulse/db db:generate",
    "db:migrate": "pnpm --filter @pulse/db db:migrate",
    "db:studio": "pnpm --filter @pulse/db db:studio",
    "db:seed": "pnpm --filter @pulse/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9"
}
