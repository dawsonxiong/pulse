# Neon Postgres — pooled for runtime, direct for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/pulse?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/pulse?sslmode=require"

# Vercel cron auth (also sent automatically by Vercel Cron)
CRON_SECRET="replace-me"

# Optional: public API + landing origin (CORS + Playwright)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Upstash Redis. Without these, rate limiting no-ops locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Extension talks to this origin (WXT host_permissions + fetch)
WXT_API_URL="http://localhost:3000"
